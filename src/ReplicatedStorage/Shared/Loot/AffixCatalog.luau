-- Clean-room Diablo (`DevilutionX` / `OpenDiablo2`) + S.T.A.L.K.E.R. (`OpenXRay`) itemization
-- catalog: 5 Rarity Tiers, Base Gear (Shield Cores, Armor, Relics, Consumables, Materials),
-- 12 Prefixes, 12 Suffixes, and 8 Named Legendaries with bespoke gameplay perks.

local WeaponCatalog = require(script.Parent.Parent.Weapons.WeaponCatalog)

export type RarityId = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary"
export type ItemCategory = "Weapon" | "ShieldCore" | "Head" | "Chest" | "Legs" | "Relic" | "Consumable" | "Material" | "Quest"

export type RarityDef = {
	id: RarityId,
	order: number,
	label: string,
	color: { r: number, g: number, b: number },
	prefixCount: number,
	suffixCount: number,
	powerMult: number,
	valueMult: number,
	baseWeight: number,
}

export type AffixDef = {
	id: string,
	name: string,
	kind: "Prefix" | "Suffix",
	minIlvl: number,
	allowedCategories: { [ItemCategory]: boolean },
	statKey: string,
	minVal: number,
	maxVal: number,
	formatLabel: (val: number) -> string,
}

export type BaseItemDef = {
	id: string,
	name: string,
	category: ItemCategory,
	description: string,
	gridW: number,
	gridH: number,
	maxStack: number,
	maxDurability: number,
	baseValue: number,
	baseStats: { [string]: number },
	assetId: string,
}

export type LegendaryDef = {
	id: string,
	name: string,
	baseId: string,
	minIlvl: number,
	perkId: string,
	perkTitle: string,
	perkDescription: string,
	fixedStats: { [string]: number },
}

